<?xml version="1.0" encoding="UTF-8"?>
<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="AdminSaveInventorySyncConfigActionGroup">
        <annotations>
            <description>Save Inventory Sync configuration</description>
        </annotations>
        <click selector="{{AdminInventorySyncConfigSection.saveConfigButton}}" stepKey="clickSaveConfig"/>
        <waitForPageLoad stepKey="waitForConfigSave"/>
        <see selector="{{AdminInventorySyncConfigSection.successMessage}}" userInput="You saved the configuration." stepKey="seeSuccessMessage"/>
    </actionGroup>
</actionGroups>
