<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <inventory_sync>
            <general>
                <enabled>1</enabled>
                <api_url>http://laravel-nginx-1/api/inventory</api_url>
                <timeout>30</timeout>
                <auto_sync>1</auto_sync>
                <sync_on_save>1</sync_on_save>
                <sync_on_order>1</sync_on_order>
                <debug_mode>1</debug_mode>
            </general>
        </inventory_sync>
    </default>
</config>
