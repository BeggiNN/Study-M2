# IDE / OS‑files
/.buildpath
/.cache
/.metadata
/.project
/.settings
/.vscode
/.idea
.DS_Store
Thumbs.db
ehthumbs.db
Icon?

# Atlassian / other project files
atlassian*
/nbproject

# Node & front‑end tools
/node_modules
/.grunt
/Gruntfile.js
/grunt-config.json
/package.json

# Composer vendor + autogenerated code
/vendor/*
!/vendor/.htaccess

/generated/*
!/generated/.htaccess

/var/*
!/var/.htaccess

/pub/static/*
!/pub/static/.htaccess

/pub/media/*
!/pub/media/.htaccess

# Magento config files with sensitive data
/app/etc/env.php
/app/etc/config.php

# Other files you don’t want versioned
/log/
*.log
*.sql
*.sqlite
*.zip
*.tar.gz
*.gz
*.7z

# Additional Magento build/test directories
/dev/*
/setup/*
/update/*
/dev/tests/*
/dev/tools/*

# Exclude all files but allow these
!/composer.json
!/composer.lock
!/README.md
